# Copy to .env for local development. All values below are safe dummies.
CS_ENVIRONMENT=development
CS_LOG_LEVEL=INFO
CS_DOCS_ENABLED=true

CS_DATABASE_URL=sqlite+aiosqlite:///./data/central_security.db
CS_DB_POOL_SIZE=5
CS_DB_MAX_OVERFLOW=5
CS_DB_POOL_TIMEOUT_SECONDS=30
CS_DB_BUSY_TIMEOUT_MS=5000

# JWT validation (tokens are issued by the external identity provider).
CS_JWT_ISSUER=https://idp.example.internal
CS_JWT_AUDIENCE=central-security
CS_JWT_ALGORITHMS=["RS256"]
CS_JWT_JWKS_URL=
# Alternatively supply a PEM public key (injected by the secret vault):
CS_JWT_PUBLIC_KEY=
# Or a path to a PEM file mounted from the vault:
CS_JWT_PUBLIC_KEY_PATH=
CS_JWT_CLIENT_ID_CLAIM=client_id
CS_JWT_ROLES_CLAIM=roles
CS_JWT_LEEWAY_SECONDS=10
CS_JWKS_CACHE_TTL_SECONDS=300
CS_JWKS_TIMEOUT_SECONDS=3
CS_JWKS_MIN_REFRESH_INTERVAL_SECONDS=30

CS_CORS_ORIGINS=["http://localhost:3000"]
CS_MAX_REQUEST_BODY_BYTES=1048576

CS_AUTH_FAILURE_LIMIT_PER_MINUTE=20
CS_DEFAULT_CALLER_RATE_LIMIT_PER_MINUTE=60

CS_PROVIDER_TIMEOUT_SECONDS=30
CS_PROVIDER_MAX_RETRIES=2
CS_PROVIDER_BACKOFF_BASE_SECONDS=0.2
CS_PROVIDER_MAX_CONCURRENCY=16
CS_MAX_RESPONSE_BYTES=262144

CS_METRICS_ENABLED=true
CS_METRICS_TOKEN=
